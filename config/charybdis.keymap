#include "keys_nb_osx.h"
#include "keys_nb_win.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define MAC 1
#define LWR 2
#define RSE 3
#define MOUSE 4
#define SCRL 5
#define SNIPER 6

&lt { quick_tap_ms = <220>; };

&mt { quick_tap_ms = <220>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default {
            display-name = "Default";
            // | Y | U | I | O | P | BSPC |
            // | H | J | K | L | ; |  '   |
            // | N | M | , | . | MOUSE | GUI |
            //         | SFT/ENT | RSE | GUI |

            bindings = <
&kp Y  &kp U  &kp I      &kp O     &kp P       &kp BACKSPACE
&kp H  &kp J  &kp K      &kp L     &kp SEMICOLON  &kp SINGLE_QUOTE
&kp N  &kp M  &kp COMMA  &kp DOT   &mo MOUSE   &kp LEFT_GUI
                     &mt LSHFT ENTER  &mo RSE  &kp LEFT_GUI
            >;
        };

        default_macos {
            display-name = "Default (macOS)";

            bindings = <
&kp Y  &kp U  &kp I      &kp O     &kp P       &kp BACKSPACE
&kp H  &kp J  &kp K      &kp L     &kp SEMICOLON  &kp SINGLE_QUOTE
&kp N  &kp M  &kp COMMA  &kp DOT   &mo MOUSE   &kp LCTRL
                     &mt LSHFT ENTER  &mo RSE  &kp LCTRL
            >;
        };

        number_symbols {
            display-name = "Numbers";

            bindings = <
&kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp PLUS  &kp MINUS  &kp DELETE
&kp LEFT_PARENTHESIS  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp EQUAL  &kp UNDERSCORE  &kp TILDE
&kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp PIPE  &kp SLASH  &kp NON_US_BACKSLASH
                                          &trans  &trans  &trans
            >;
        };

        system {
            display-name = "System";

            bindings = <
&trans  &kp PAGE_UP  &kp UP_ARROW  &kp PAGE_DOWN  &trans  &kp DELETE
&kp HOME  &kp LEFT  &kp DOWN  &kp RIGHT  &kp END  &trans
&kp C_VOLUME_DOWN  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_VOLUME_UP  &kp C_MUTE
                          &trans  &trans  &trans
            >;
        };

        mouse {
            display-name = "Mouse";

            bindings = <
&trans  &trans  &trans    &trans      &trans  &trans
&trans  &trans  &mkp MB3  &mo SNIPER  &trans  &trans
&trans  &mkp MB1  &mkp MB2  &mo SCRL  &trans  &trans
                        &trans  &trans  &trans
            >;
        };

        scroll {
            display-name = "Scroll";

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans
            >;
        };

        sniper {
            display-name = "Sniper";

            bindings = <
&trans  &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans    &trans    &trans  &trans
&trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
                        &trans  &trans  &trans
            >;
        };

        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };
    };
};

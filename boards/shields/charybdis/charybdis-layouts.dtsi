#include <physical_layouts.dtsi>

/ {
    charybdis_physical_layout: charybdis_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Charybdis Right";
        transform = <&default_transform>;

        keys
            // Row 0
            //                       w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   45       0     0     0>
            , <&key_physical_attrs 100 100  100   30       0     0     0>
            , <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  300   35       0     0     0>
            , <&key_physical_attrs 100 100  400  105       0     0     0>
            , <&key_physical_attrs 100 100  500  105       0     0     0>
            // Row 1
            , <&key_physical_attrs 100 100    0  145       0     0     0>
            , <&key_physical_attrs 100 100  100  130       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  300  135       0     0     0>
            , <&key_physical_attrs 100 100  400  205       0     0     0>
            , <&key_physical_attrs 100 100  500  205       0     0     0>
            // Row 2
            , <&key_physical_attrs 100 100    0  245       0     0     0>
            , <&key_physical_attrs 100 100  100  230       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  300  235       0     0     0>
            , <&key_physical_attrs 100 100  400  305       0     0     0>
            , <&key_physical_attrs 100 100  500  305       0     0     0>
            // Thumbs
            , <&key_physical_attrs 100 100  -90  340 (-2600)    50   460>
            , <&key_physical_attrs 100 100    5  330 (-1300)   150   425>
            , <&key_physical_attrs 100 100  110  340       0     0     0>
            ;
    };
};
